{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitcoingazete",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Alan adı: Cloudflare'de bitcoingazete.com zone'u aktif olduktan sonra açın.
  // "routes": [
  //   { "pattern": "bitcoingazete.com", "custom_domain": true },
  //   { "pattern": "www.bitcoingazete.com", "custom_domain": true }
  // ],

  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Anlık ziyaretçi sayacı
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveCounter"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitcoingazete",
      "database_id": "f10affda-d8b5-465d-91e2-4ec885feb293",
      "migrations_dir": "migrations"
    }
  ],

  // Yapay zeka ile kapak görseli (isteğe bağlı). Kapatmak için IMAGE_GENERATION=off yapın.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bitcoingazete-media" }],
  "ai": { "binding": "AI" },

  // Günde 5 kez (UTC 04, 08, 12, 16, 20 = TSİ 07, 11, 15, 19, 23): kaynakları tara, haber seç, yaz, kontrol et, yayınla.
  "triggers": { "crons": ["0 4,8,12,16,20 * * *"] },

  "observability": { "enabled": true },

  "vars": {
    "SITE_URL": "https://bitcoingazete.com",
    "SITE_NAME": "Bitcoin Gazete",
    "PUBLISH_MODE": "review",
    "ARTICLES_PER_RUN": "1",
    "DAILY_LIMIT": "5",
    "MIN_QUALITY_SCORE": "7.5",
    "MAX_REVISIONS": "2",
    "WRITER_MODEL": "claude-sonnet-5-5",
    "EDITOR_MODEL": "claude-sonnet-5-5",
    "IMAGE_GENERATION": "on",
    "AI_MOCK": "off"
  }
  // Gizli değişkenler (wrangler secret put ile):
  //   ANTHROPIC_API_KEY, ADMIN_PASSWORD, (isteğe bağlı) COINGECKO_API_KEY
}
